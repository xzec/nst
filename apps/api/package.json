{
  "name": "@workspace/api",
  "version": "0.0.1",
  "author": "xzec",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@nestjs/common": "11.1.29",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.29",
    "@nestjs/platform-express": "11.1.29",
    "@nestjs/swagger": "11.4.6",
    "@scalar/nestjs-api-reference": "1.2.14",
    "@workspace/database": "workspace:*",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.8.3",
    "oxide.ts": "1.1.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.29",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.47",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.12.0",
    "@types/pg": "8.21.0",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.10",
    "jest": "30.4.2",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "unplugin-swc": "1.5.11",
    "vitest": "4.1.10"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^~/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
